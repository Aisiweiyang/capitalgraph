# CapitalGraph 环境变量示例
# 复制为 .env（或直接 export）后按需修改；所有变量均有安全默认值，本地演示可零配置。
#
# 加载方式（二选一）：
#   uvicorn --env-file .env cg_api.main:app --port 8300   # 启动时载入
#   或在 shell 中 export 后再启动（systemd/docker 场景由环境注入）

# ---- 必配（生产）----
# JWT 签名密钥；CG_ENV=production 时未配置将拒绝启动。生成示例：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CG_SECRET_KEY=

# ---- 数据库 ----
# 默认 SQLite（自动建目录）；PostgreSQL：postgresql+asyncpg://cg:cg@localhost:5432/capitalgraph
CG_DATABASE_URL=sqlite+aiosqlite:///./data/capitalgraph.sqlite3

# ---- 运行环境 ----
# production 时强制要求 CG_SECRET_KEY
CG_ENV=development
# 日志级别（DEBUG/INFO/WARNING）
CG_LOG_LEVEL=INFO

# ---- 鉴权 ----
# 访问令牌有效期（分钟），默认 120（2 小时）
#CG_ACCESS_TOKEN_MINUTES=120

# ---- 限流 ----
# 每 IP 每分钟请求数（默认 120）。本地跑全量 E2E 建议对 8301 端口实例设 1200
CG_RATE_LIMIT_PER_MINUTE=120
# 部署在可信反向代理（nginx/Caddy）之后时设 true，限流按 X-Forwarded-For 区分真实客户端；
# 默认 false（该头可被伪造，直连暴露时信任它等于限流失效）
#CG_TRUST_PROXY=false

# ---- 口令哈希成本（默认与 argon2-cffi 库默认一致；测试套件用低档位换速度）----
#CG_ARGON2_TIME_COST=3
#CG_ARGON2_MEMORY_COST=65536
#CG_ARGON2_PARALLELISM=4

# ---- 前端 ----
# 开发模式 vite 代理目标（后端不在 8300 时修改）
#CG_API_PROXY=http://127.0.0.1:8300
# 后端托管的前端构建产物目录
#CG_WEB_DIST=apps/web/dist

# ---- CORS ----
# 逗号分隔的允许来源
#CG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
